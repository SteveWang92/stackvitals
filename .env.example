# Local development environment template. Copy to `.env` and fill in real values.
#
# Tags show where each value must ALSO be configured outside this file:
#   [GITHUB]          GitHub Actions secret (scheduled collector, .github/workflows/collect.yml)
#   [HOSTING]         static host's build-time env var (frontend deploy — e.g. Amplify,
#                     Cloudflare Pages, Netlify, Vercel)
#   [GITHUB+HOSTING]  same prod value needed in BOTH places
#   (no tag)          local/collector-script use only, never deployed elsewhere

# [GITHUB+HOSTING] Hub Supabase project — frontend reads + collector writes results here
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# [HOSTING] gates frontend login (src/lib/supabase.ts); not read by any collector.
# Comma-separated list for more than one allowed email.
VITE_DASHBOARD_ALLOWED_EMAIL=

# Local-only login for the `npm run db:up` Supabase stack. The email defaults to the
# first VITE_DASHBOARD_ALLOWED_EMAIL entry; the password is generated and stored in
# the git-ignored `.env.local` unless you pin your own here. Never a prod password.
LOCAL_DEV_EMAIL=
LOCAL_DEV_PASSWORD=

# [GITHUB] service-role key that writes collector results — never add to the frontend
# host's env vars, it must not reach the browser
HUB_SUPABASE_JWT_SERVICE_ROLE_KEY=

# [GITHUB] Per-app credentials referenced by `${...}` placeholders in the collector
# config (projects.config.json). Name them whatever you like — the config decides which
# variables are read. Every variable the config references must be set (empty disables
# that adapter); a missing variable fails the collector run with an error naming it.
# Mirror the same names in the workflow env block (.github/workflows/collect.yml).
# Example for one watched app whose Supabase is polled via a count-only aggregate RPC:
MY_APP_SUPABASE_URL=
MY_APP_SUPABASE_SERVICE_ROLE_KEY=
MY_APP_SUPABASE_ANON_KEY=

# [GITHUB] Amplify + Cost Explorer collectors' AWS API credentials (unrelated to any
# frontend hosting on Amplify, which uses its own IAM role)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# [GITHUB] Resend verification-email collector
RESEND_API_KEY=

# [GITHUB] OpenAI usage collector
OPENAI_ADMIN_API_KEY=

# [GITHUB] GitHub Actions usage collector; optional — falls back to the workflow's
# built-in github.token if unset. Named GH_ACTIONS_TOKEN, not GITHUB_ACTIONS_TOKEN,
# because GitHub Actions secret names may not start with the reserved GITHUB_ prefix.
GH_ACTIONS_TOKEN=

# [GITHUB] Cloudflare domains collector
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# [GITHUB] Optional: sent as a request header on the public-URL health check so a
# Cloudflare WAF rule can skip Bot Fight Mode for this collector only.
HTTP_HEALTH_CHECK_HEADER_NAME=
HTTP_HEALTH_CHECK_HEADER_VALUE=

# [GITHUB] Optional: how many days of append-only snapshots to keep. Defaults to 90.
# Must be at least 31 so the dashboard's 30-day history charts stay intact.
SNAPSHOT_RETENTION_DAYS=

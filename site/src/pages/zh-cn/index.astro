---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Image, getImage } from 'astro:assets';
import overviewImg from '../../assets/screenshots/01-overview-cropped.png';

const heroImage = await getImage({ src: overviewImg, width: 695 });
import appDetailImg from '../../assets/screenshots/02-app-detail.png';
import collectorsImg from '../../assets/screenshots/03-collectors.png';
import domainsImg from '../../assets/screenshots/04-domains.png';
import usageImg from '../../assets/screenshots/05-usage.png';
import costsImg from '../../assets/screenshots/06-costs.png';

const features = [
  { icon: '🟢', title: '正常运行时间监控', desc: '对公共 URL 进行 HTTP 健康检查。响应时间、状态码、可用/不可用历史。' },
  { icon: '🚀', title: '部署状态', desc: 'AWS Amplify 构建状态、分支和最新部署时间戳一目了然。' },
  { icon: '💰', title: '云成本', desc: 'AWS Cost Explorer 当月与上月对比，按服务细分。' },
  { icon: '🤖', title: 'AI 使用量', desc: 'OpenAI Token 总数、请求次数、缓存 Token 以及按 API Key 和模型的花费。' },
  { icon: '⚙️', title: 'CI 状态', desc: 'GitHub Actions 工作流运行次数、最新状态、触发类型和定时运行健康状况。' },
  { icon: '🌐', title: '域名健康', desc: 'Cloudflare zone 状态、DNS 记录数、apex/www/MX 存在性和注册商过期信息。' },
  { icon: '✉️', title: '邮件投递', desc: 'Resend 发送域名验证状态，用于你的事务性邮件设置。' },
  { icon: '🗄️', title: '数据库健康', desc: 'Supabase 项目可达性以及来自你应用的仅计数聚合统计。' },
];

const screenshots = [
  { src: appDetailImg, alt: '应用详情视图，显示每个项目的提供商状态和健康检查', caption: '应用详情' },
  { src: collectorsImg, alt: '采集器诊断，显示运行历史和错误状态', caption: '采集器' },
  { src: domainsImg, alt: '域名清单，显示 Cloudflare zone 和 DNS 状态', caption: '域名' },
  { src: usageImg, alt: '使用量视图，显示 OpenAI Token 计数和 GitHub Actions 运行', caption: '使用量' },
  { src: costsImg, alt: '成本明细，显示按 AWS 服务的当月与上月对比', caption: '成本' },
];
---

<StarlightPage
  frontmatter={{
    title: 'StackVitals — 独立开发者的状态中心',
    description:
      '独立开发者的状态中心——正常运行时间、部署状态、云成本和 AI/CI 使用量，尽在一个轻量级、自托管的仪表盘中。',
    template: 'splash',
    hero: {
      title: '所有个人项目，一个仪表盘',
      tagline:
        '独立开发者的状态中心——正常运行时间、部署状态、云成本和 AI/CI 使用量，尽在一个轻量级、自托管、单数据库的仪表盘中。',
      image: {
        html: `<img src="${heroImage.src}" alt="StackVitals 概览仪表盘，显示多个项目的部署状态、正常运行时间和成本" width="${heroImage.attributes.width}" height="${heroImage.attributes.height}" loading="eager" decoding="async" class="hero-screenshot" />`,
      },
      actions: [
        { text: '开始使用', link: '/zh-cn/getting-started/self-hosting/', icon: 'right-arrow' },
        {
          text: '在线演示',
          link: 'https://stackvitals.app',
          icon: 'external',
          variant: 'secondary',
          attrs: { target: '_blank', rel: 'noopener' },
        },
        {
          text: '在 GitHub 上查看',
          link: 'https://github.com/SteveWang92/stackvitals',
          icon: 'external',
          variant: 'minimal',
          attrs: { rel: 'me' },
        },
      ],
    },
  }}
>
  <div class="landing">

    <section class="features">
      <h2>监控内容</h2>
      <p class="section-subtitle">
        每个适配器都是可选的——只有在提供了相应凭证时才会激活。只启用你需要的适配器。
      </p>
      <div class="feature-grid">
        {features.map(f => (
          <div class="feature-card">
            <div class="feature-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="screenshots">
      <h2>全方位查看</h2>
      <p class="section-subtitle">
        通过标签页视图查看应用详情、采集器诊断、域名清单、使用量汇总和成本明细。
      </p>
      <div class="screenshot-grid">
        {screenshots.map(s => (
          <figure>
            <Image src={s.src} alt={s.alt} />
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="how-it-works">
      <h2>工作原理</h2>
      <p class="section-subtitle">两个组成部分，都在一个仓库中。没有常驻服务。</p>
      <div class="architecture-cards">
        <div class="arch-card">
          <div class="arch-number">1</div>
          <h3>采集器收集数据</h3>
          <p>
            Node 脚本调用提供商 API（AWS、Supabase、OpenAI、GitHub、Cloudflare、Resend），将追加写入的快照存入你的 Supabase 数据库。它们通过 GitHub Actions 定时运行——从不在浏览器中执行。
          </p>
        </div>
        <div class="arch-arrow">→</div>
        <div class="arch-card">
          <div class="arch-number">2</div>
          <h3>仪表盘读取并渲染</h3>
          <p>
            静态 React/Vite 前端从 Supabase 读取预聚合的数据行并进行渲染。原始应用数据永远不会离开你的源项目——只有计数、状态和成本。
          </p>
        </div>
      </div>
    </section>

    <section class="adapters">
      <h2>支持的适配器</h2>
      <p class="section-subtitle">
        每个适配器只采集仪表盘需要的数据，使用所需的最小权限。
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>适配器</th>
              <th>采集内容</th>
              <th>凭证</th>
              <th>最小权限</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>HTTP 健康检查</td>
              <td>公共 URL 的可用性和响应时间</td>
              <td>无（只需项目的公共 URL）</td>
              <td>—</td>
            </tr>
            <tr>
              <td>Amplify</td>
              <td>部署状态、分支、最新构建</td>
              <td>AWS access key/secret、region</td>
              <td>只读 Amplify 访问</td>
            </tr>
            <tr>
              <td>AWS Cost Explorer</td>
              <td>按 AWS 服务划分的账户级当月/上月成本</td>
              <td>AWS access key/secret、region</td>
              <td>只读 Cost Explorer 访问</td>
            </tr>
            <tr>
              <td>Supabase 项目健康</td>
              <td>仪表盘自身项目或被监控应用的可达性</td>
              <td>Supabase 项目 URL + service-role key</td>
              <td>项目范围的 service-role key</td>
            </tr>
            <tr>
              <td>被监控应用 Supabase 聚合</td>
              <td>通过自定义 RPC 获取的仅计数聚合统计</td>
              <td>应用的 Supabase URL、anon key、service-role key、RPC 名称</td>
              <td>Service-role key（仅计数 RPC——从不读取原始数据）</td>
            </tr>
            <tr>
              <td>Resend</td>
              <td>发送域名验证状态</td>
              <td>Resend API key</td>
              <td>只读 API key</td>
            </tr>
            <tr>
              <td>OpenAI 使用量</td>
              <td>Token 总数、请求次数、缓存 Token、按 Key/模型的花费</td>
              <td>OpenAI admin API key</td>
              <td>Admin key（使用量端点需要）</td>
            </tr>
            <tr>
              <td>GitHub Actions</td>
              <td>工作流运行次数、最新状态、触发类型、分支、持续时间</td>
              <td>仓库 <code>owner/repo</code> 映射 + 读取 token</td>
              <td>Actions: read</td>
            </tr>
            <tr>
              <td>Cloudflare 域名</td>
              <td>Zone 状态、DNS 记录数、apex/www/MX、注册商过期信息</td>
              <td>Cloudflare API token、可选 account ID</td>
              <td>只读 token（范围限定为 zones/DNS）</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="quickstart">
      <h2>五步开始</h2>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <div>
            <strong>克隆仓库</strong>
            <code>git clone https://github.com/SteveWang92/stackvitals && cd stackvitals && npm install</code>
          </div>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div>
            <strong>创建 Supabase 项目</strong>
            <span>应用 <code>supabase/migrations/</code> 中的迁移并运行 <code>supabase/seed.sql</code>。</span>
          </div>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div>
            <strong>配置环境</strong>
            <span>将 <code>.env.example</code> 复制为 <code>.env</code>，填入你的 Supabase URL、anon key 和允许的邮箱。</span>
          </div>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <div>
            <strong>描述你的项目</strong>
            <span>
              将 <code>projects.example.json</code> 复制为 <code>projects.config.json</code>——至少需要一个 slug、名称和公共 URL 即可获得 HTTP 健康监控。
            </span>
          </div>
        </div>
        <div class="step">
          <span class="step-num">5</span>
          <div>
            <strong>运行</strong>
            <code>npm run collect:status</code> <span>采集数据，然后</span> <code>npm run dev</code> <span>查看仪表盘。</span>
          </div>
        </div>
      </div>
      <div class="quickstart-cta">
        <a href="/zh-cn/getting-started/self-hosting/" class="cta-button">完整自托管指南 →</a>
      </div>
    </section>
  </div>
</StarlightPage>

{
  "name": "stackvitals",
  "version": "1.4.0",
  "description": "Stack Status Hub — a self-hosted operations dashboard for your web projects: uptime, deploy health, cloud cost, and AI/CI usage in one place.",
  "keywords": [
    "dashboard",
    "observability",
    "supabase",
    "react",
    "typescript"
  ],
  "author": "Steve Wang <contact@stevewang.me> (https://github.com/SteveWang92)",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteveWang92/stackvitals.git"
  },
  "homepage": "https://github.com/SteveWang92/stackvitals#readme",
  "bugs": {
    "url": "https://github.com/SteveWang92/stackvitals/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_DEMO_MODE=true vite",
    "dev:local": "npm run db:up && vite",
    "db:up": "node scripts/local-supabase.mjs up",
    "db:down": "node scripts/local-supabase.mjs down",
    "db:reset": "node scripts/local-supabase.mjs reset",
    "build": "tsc -b && vite build",
    "collect:http": "node scripts/manual-http-health.mjs",
    "collect:status": "vite-node src/collectors/runConfiguredCollectors.ts",
    "demo:screenshots": "node scripts/demo-screenshots/capture.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "release:prep": "node scripts/release.mjs prep",
    "release:ship": "node scripts/release.mjs ship",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1075.0",
    "@aws-sdk/client-cost-explorer": "^3.1075.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}

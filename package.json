{
  "name": "stackvitals",
  "version": "1.7.2",
  "description": "Stack Status Hub — a self-hosted operations dashboard for your web projects: uptime, deploy health, cloud cost, and AI/CI usage in one place.",
  "keywords": [
    "dashboard",
    "observability",
    "supabase",
    "react",
    "typescript"
  ],
  "author": "Steve Wang <contact@stevewang.me> (https://github.com/SteveWang92)",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteveWang92/stackvitals.git"
  },
  "homepage": "https://github.com/SteveWang92/stackvitals#readme",
  "bugs": {
    "url": "https://github.com/SteveWang92/stackvitals/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_DEMO_MODE=true vite",
    "dev:local": "npm run db:up && vite",
    "db:up": "node scripts/local-supabase.mjs up",
    "db:up:demo": "node scripts/local-supabase.mjs up --demo",
    "db:down": "node scripts/local-supabase.mjs down",
    "db:reset": "node scripts/local-supabase.mjs reset",
    "db:reset:demo": "node scripts/local-supabase.mjs reset --demo",
    "db:demo": "node scripts/local-supabase.mjs demo",
    "build": "tsc -b && vite build",
    "collect:http": "node scripts/manual-http-health.mjs",
    "collect:status": "vite-node src/collectors/runConfiguredCollectors.ts",
    "demo:screenshots": "node scripts/demo-screenshots/capture.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "release:prep": "node scripts/release.mjs prep",
    "release:reversion": "node scripts/release.mjs reversion",
    "release:ship": "node scripts/release.mjs ship",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1101.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1116.0",
    "@aws-sdk/client-cost-explorer": "^3.1101.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
